
---
const current = Astro.url.pathname;
const active = (path: string) => path === '/' ? current === '/' : current.startsWith(path);
---
<header class="site-header">
<a class="brand" href="/" aria-label="Bobolothèque, accueil"><svg width="25" height="25" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5c-3-2-6-2-10-1v15c4-1 7-1 10 1 3-2 6-2 10-1V4c-4-1-7-1-10 1Zm0 0v15" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>Bobolothèque<span>LE PLAISIR DES PAGES</span></a>
<nav class="navbar" aria-label="Navigation principale">
    <a href="/" aria-current={active('/') ? 'page' : undefined}>Accueil</a>
    <a id="nav-library" href="/bibliotheque" aria-current={active('/bibliotheque') ? 'page' : undefined}>Ma bibliothèque</a>
    <a href="/livres" aria-current={active('/livres') ? 'page' : undefined}>Livres</a>
    <a id="nav-login" href="/login" aria-current={active('/login') ? 'page' : undefined} hidden>Connexion</a>
    <a id="nav-session" href="/profil" aria-current={active('/profil') ? 'page' : undefined} hidden>Mon profil</a>
</nav>
</header>

<script>
    import { getSession, profileUrl } from '../lib/auth';
    async function afficherSession(refresh = false) {
        const link = document.querySelector<HTMLAnchorElement>('#nav-login');
        const status = document.querySelector<HTMLAnchorElement>('#nav-session');
        if (!link || !status) return;
        const user = await getSession(refresh);
        link.hidden = Boolean(user);
        status.hidden = !user;
        if (user) status.href = profileUrl(user.pseudo);
    }
    void afficherSession();
    window.addEventListener('pageshow', (event) => {
        if (event.persisted) void afficherSession(true);
    });
</script>

<style>
.site-header {
  max-width:1120px;
  margin:auto;
  padding:1.8rem 2rem 0;
}
.brand {
  display:flex;
  justify-content:center;
  align-items:center;
  gap:.65rem;
  flex-wrap:wrap;
  font-family:Georgia,serif;
  font-size:1.7rem;
  text-decoration:none;
  letter-spacing:-.04em;
}
.brand span {
  flex-basis:100%;
  text-align:center;
  font-family:Arial,sans-serif;
  font-size:.55rem;
  letter-spacing:.24em;
  color:var(--muted);
  margin-top:-.3rem;
}
.navbar {
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:.4rem 1.3rem;
  align-items:center;
  padding:1.2rem 0;
  border-bottom:1px solid var(--line);
}
.navbar a {
  padding:.4rem .65rem;
  text-decoration:none;
  color:var(--muted);
  font-size:.85rem;
  border-radius:5px;
}
.navbar a[aria-current=page] {
  background:#e5eadd;
  color:var(--green);
}
.navbar a:hover {
  color:var(--green);
  background:#eaece4;
}
@media(max-width:520px) {
  .site-header {
    padding:1.2rem 1rem 0;
  }
  .navbar {
    gap:.3rem;
  }
  .navbar a {
    font-size:.8rem;
    padding:.4rem .5rem;
  }
}
</style>
