# Fichier shell de confiance, lu par les scripts. Protéger avec chmod 600.
# Sauvegardes locales uniquement, sur le VPS.
RESTIC_REPOSITORY='/var/backups/bibliotheque-restic'
RESTIC_PASSWORD_FILE='/etc/bibliotheque/restic-password'
BACKUP_STATE_DIR='/var/lib/bibliotheque-backup'
BACKUP_HOST='bibliotheque-vps'
RESTORE_POSTGRES_IMAGE='postgres:18.6-trixie'
