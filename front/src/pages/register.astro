---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout>
	<Navbar />

	<main class="register-page">
		<form id="register-form" class="register-form">
			<h1>Inscription</h1>

			<label for="pseudo">Pseudo</label>
			<input
				type="text"
				id="pseudo"
				name="pseudo"
				placeholder="Votre pseudo"
				maxlength="100"
				required
			/>

			<label for="email">Mail</label>
			<input
				type="email"
				id="email"
				name="email"
				placeholder="Votre adresse mail"
				maxlength="255"
				required
			/>

			<label for="mot_de_passe">Mot de passe</label>
			<input
				type="password"
				id="mot_de_passe"
				name="mot_de_passe"
				placeholder="Votre mot de passe"
				minlength="12"
				maxlength="128"
				required
			/>

			<label for="confirm-password">Confirmer le mot de passe</label>
			<input
				type="password"
				id="confirm-password"
				placeholder="Confirmez votre mot de passe"
				minlength="12"
				maxlength="128"
				required
			/>

			<p id="error-message" class="error-message" role="alert"></p>

			<button type="submit">Créer un compte</button>

			<p>
				Déjà un compte ?
				<a href="/login">Se connecter</a>
			</p>
		</form>
	</main>
</Layout>

<script>
	import { API_URL, authError, getSession } from '../lib/auth';
	const form = document.querySelector<HTMLFormElement>('#register-form');
	const error = document.querySelector<HTMLParagraphElement>('#error-message');
	const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
	let busy = false;
	void getSession().then((user) => {
		if (user && !busy) window.location.replace('/bibliotheque');
	});

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (busy || !error || !submit) return;
		error.textContent = '';
		const data = new FormData(form);
		const pseudo = String(data.get('pseudo') ?? '').trim();
		const email = String(data.get('email') ?? '').trim();
		const mot_de_passe = String(data.get('mot_de_passe') ?? '');
		const confirmation = document.querySelector<HTMLInputElement>('#confirm-password')?.value;
		if (!pseudo || !email || !mot_de_passe || !confirmation) {
			error.textContent = 'Veuillez renseigner tous les champs.';
			return;
		}
		if (mot_de_passe !== confirmation) {
			error.textContent = 'Les mots de passe ne correspondent pas.';
			return;
		}
		busy = true;
		submit.disabled = true;
		submit.textContent = 'Création du compte…';
		try {
			const response = await fetch(`${API_URL}/auth/register`, {
				method: 'POST', credentials: 'include',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ pseudo, email, mot_de_passe }),
			});
			if (!response.ok) {
				error.textContent = await authError(response, 'L’inscription a échoué.');
				return;
			}
			window.location.assign('/login?registered=1');
		} catch {
			error.textContent = 'Impossible de contacter le serveur. Vérifiez votre connexion et réessayez.';
		} finally {
			busy = false;
			submit.disabled = false;
			submit.textContent = 'Créer un compte';
		}
	});
</script>

<style>
	.register-page {
		min-height: calc(100vh - 70px);
		display: flex;
		justify-content: center;
		align-items: center;
		padding: 2rem;
	}

	.register-form {
		width: 100%;
		max-width: 400px;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 2rem;
		border: 1px solid #ddd;
		border-radius: 10px;
	}

	.register-form h1 {
		margin: 0 0 1rem;
		text-align: center;
	}

	.register-form input {
		padding: 0.8rem;
		border: 1px solid #ccc;
		border-radius: 6px;
		font-size: 1rem;
	}

	.register-form button {
		padding: 0.8rem;
		border: none;
		border-radius: 6px;
		cursor: pointer;
		font-size: 1rem;
	}

	.register-form button:hover {
		opacity: 0.8;
	}

	.error-message {
		color: red;
		margin: 0;
	}
</style>