---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout>
	<Navbar />

	<main id="contenu" class="login-page">
		<form id="login-form" class="login-form">
			<p class="eyebrow">Votre espace lecture</p><h1>Bon retour.</h1><p class="intro">Vos livres vous attendent.</p>

			<label for="email">Adresse email</label>
			<input
				type="email"
				id="email"
				name="email"
				placeholder="Votre email"
				required
			/>

			<label for="mot_de_passe">Mot de passe</label>
			<input
				type="password"
				id="mot_de_passe"
				name="mot_de_passe"
				placeholder="Votre mot de passe"
				required
			/>

			<p id="login-error" class="error-message" role="alert"></p>
			<p id="login-notice" role="status"></p>
			<button type="submit">Se connecter</button>

			<p>
				<a href="/register">Créer un compte</a>
			</p>
		</form>
	</main>
</Layout>

<script>
	import { API_URL, authError, getSession } from '../lib/auth';
	const form = document.querySelector<HTMLFormElement>('#login-form');
	const error = document.querySelector<HTMLParagraphElement>('#login-error');
	const notice = document.querySelector<HTMLParagraphElement>('#login-notice');
	const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
	let busy = false;

	if (notice && new URLSearchParams(location.search).get('registered') === '1') {
		notice.textContent = 'Votre compte a été créé. Vous pouvez vous connecter.';
	}
	void getSession().then((user) => {
		if (user && !busy) window.location.replace('/bibliotheque');
	});

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (busy || !error || !submit) return;
		error.textContent = '';
		if (notice) notice.textContent = '';
		const data = new FormData(form);
		const email = String(data.get('email') ?? '').trim();
		const mot_de_passe = String(data.get('mot_de_passe') ?? '');
		if (!email || !mot_de_passe) {
			error.textContent = 'Renseignez votre email et votre mot de passe.';
			return;
		}
		busy = true;
		submit.disabled = true;
		submit.textContent = 'Connexion…';
		try {
			const response = await fetch(`${API_URL}/auth/login`, {
				method: 'POST', credentials: 'include',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email, mot_de_passe }),
			});
			if (!response.ok) {
				error.textContent = await authError(response, 'La connexion a échoué.');
				return;
			}
			const user = await getSession(true);
			if (!user) {
				error.textContent = user === null
					? 'La session n’a pas été conservée. Vérifiez que votre navigateur autorise les cookies du site.'
					: 'Impossible de vérifier votre session. Réessayez.';
				return;
			}
			window.location.assign('/bibliotheque');
		} catch {
			error.textContent = 'Impossible de contacter le serveur. Vérifiez votre connexion et réessayez.';
		} finally {
			busy = false;
			submit.disabled = false;
			submit.textContent = 'Se connecter';
		}
	});
</script>
