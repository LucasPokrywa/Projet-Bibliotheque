---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout>
	<Navbar />

	<main class="register-page">
		<form id="register-form" class="register-form">
			<h1>Inscription</h1>

			<label for="pseudo">Pseudo</label>
			<input
				type="text"
				id="pseudo"
				name="pseudo"
				placeholder="Votre pseudo"
				maxlength="100"
				required
			/>

			<label for="email">Mail</label>
			<input
				type="email"
				id="email"
				name="email"
				placeholder="Votre adresse mail"
				maxlength="255"
				required
			/>

			<label for="mot_de_passe">Mot de passe</label>
			<input
				type="password"
				id="mot_de_passe"
				name="mot_de_passe"
				placeholder="Votre mot de passe"
				minlength="12"
				maxlength="128"
				required
			/>

			<label for="confirm-password">Confirmer le mot de passe</label>
			<input
				type="password"
				id="confirm-password"
				placeholder="Confirmez votre mot de passe"
				minlength="12"
				maxlength="128"
				required
			/>

			<p id="error-message" class="error-message"></p>

			<button type="submit">Créer un compte</button>

			<p>
				Déjà un compte ?
				<a href="/login">Se connecter</a>
			</p>
		</form>
	</main>
</Layout>

<script>
	const form = document.querySelector<HTMLFormElement>('#register-form');
	const errorMessage =
		document.querySelector<HTMLParagraphElement>('#error-message');

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();

		const pseudo =
			document.querySelector<HTMLInputElement>('#pseudo')?.value;

		const email =
			document.querySelector<HTMLInputElement>('#email')?.value;

		const mot_de_passe =
			document.querySelector<HTMLInputElement>('#mot_de_passe')?.value;

		const confirmPassword =
			document.querySelector<HTMLInputElement>('#confirm-password')?.value;

		if (!pseudo || !email || !mot_de_passe || !confirmPassword) {
			return;
		}

		if (mot_de_passe !== confirmPassword) {
			if (errorMessage) {
				errorMessage.textContent =
					'Les mots de passe ne correspondent pas.';
			}

			return;
		}

		try {
			const response = await fetch(
				'https://api.bibliotheque.lucaspokrywa.site/v1/auth/register',
				{
					method: 'POST',

					headers: {
						'Content-Type': 'application/json'
					},

					body: JSON.stringify({
						pseudo,
						email,
						mot_de_passe
					})
				}
			);

			if (!response.ok) {
				const data = await response.json();

				if (errorMessage) {
					errorMessage.textContent =
						data.message ?? "Erreur lors de l'inscription.";
				}

				return;
			}

			window.location.href = '/login';

		} catch (error) {
			console.error(error);

			if (errorMessage) {
				errorMessage.textContent =
					"Impossible de contacter l'API.";
			}
		}
	});
</script>

<style>
	.register-page {
		min-height: calc(100vh - 70px);
		display: flex;
		justify-content: center;
		align-items: center;
		padding: 2rem;
	}

	.register-form {
		width: 100%;
		max-width: 400px;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 2rem;
		border: 1px solid #ddd;
		border-radius: 10px;
	}

	.register-form h1 {
		margin: 0 0 1rem;
		text-align: center;
	}

	.register-form input {
		padding: 0.8rem;
		border: 1px solid #ccc;
		border-radius: 6px;
		font-size: 1rem;
	}

	.register-form button {
		padding: 0.8rem;
		border: none;
		border-radius: 6px;
		cursor: pointer;
		font-size: 1rem;
	}

	.register-form button:hover {
		opacity: 0.8;
	}

	.error-message {
		color: red;
		margin: 0;
	}
</style>