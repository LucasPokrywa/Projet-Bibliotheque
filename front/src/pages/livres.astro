---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout>
	<Navbar />
	<main class="livres-page">
		<h1>Livres disponibles</h1>
		<section aria-labelledby="recherche-titre">
			<h2 id="recherche-titre">Rechercher et ajouter un livre</h2>
			<form id="recherche-livre">
				<label for="recherche-isbn">ISBN</label>
				<input id="recherche-isbn" name="isbn" type="text" required maxlength="32" placeholder="9782070612758" />
				<button id="rechercher" type="submit">Rechercher</button>
			</form>
			<p id="recherche-status" role="status"></p>
			<p id="recherche-login" hidden><a href="/login">Se connecter</a></p>
			<form id="ajout-livre" hidden>
				<fieldset id="ajout-champs">
					<legend>Livre trouvé</legend>
					<dl class="livre-resultat">
						<dt>ISBN recherché</dt>
						<dd id="ajout-isbn"></dd>
						<dt>Titre</dt>
						<dd id="ajout-titre"></dd>
						<dt>Auteur(s)</dt>
						<dd id="ajout-auteur"></dd>
					</dl>
					<button type="submit">Ajouter à ma bibliothèque</button>
				</fieldset>
			</form>
		</section>
		<p id="livres-status" role="status">Chargement des livres…</p>
		<p id="livres-login" hidden><a href="/login">Se connecter</a></p>
		<ul id="livres-liste" aria-label="Livres disponibles" hidden></ul>
	</main>
</Layout>

<script>
	const apiUrl = 'https://api.bibliotheque.lucaspokrywa.site/v1/livres';
	const bibliothequeUrl = 'https://api.bibliotheque.lucaspokrywa.site/v1/bibliotheque';

	async function messageErreur(response: Response): Promise<string> {
		if (response.status === 401) return 'Connectez-vous pour rechercher ou ajouter un livre.';
		if (response.status === 409) return 'Ce livre est déjà présent dans le catalogue.';
		if (response.status === 404) return 'Aucun livre trouvé pour cet ISBN.';
		if (response.status === 429) return 'Trop de requêtes. Patientez avant de réessayer.';
		const problem = await response.json().catch(() => null);
		return typeof problem?.detail === 'string'
			? problem.detail
			: 'La requête a échoué. Réessayez plus tard.';
	}

	function initialiserRecherche() {
		const recherche = document.querySelector<HTMLFormElement>('#recherche-livre');
		const isbn = document.querySelector<HTMLInputElement>('#recherche-isbn');
		const bouton = document.querySelector<HTMLButtonElement>('#rechercher');
		const status = document.querySelector<HTMLParagraphElement>('#recherche-status');
		const login = document.querySelector<HTMLParagraphElement>('#recherche-login');
		const ajout = document.querySelector<HTMLFormElement>('#ajout-livre');
		const champs = document.querySelector<HTMLFieldSetElement>('#ajout-champs');
		const isbnAjout = document.querySelector<HTMLElement>('#ajout-isbn');
		const titre = document.querySelector<HTMLElement>('#ajout-titre');
		const auteur = document.querySelector<HTMLElement>('#ajout-auteur');
		if (!recherche || !isbn || !bouton || !status || !login || !ajout || !champs || !isbnAjout || !titre || !auteur) return;
		let enCours = false;
		let livreId: number | undefined;

		isbn.addEventListener('input', () => {
			ajout.hidden = true;
			livreId = undefined;
			status.textContent = '';
		});

		recherche.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (enCours) return;
			const valeur = isbn.value.replace(/[\s-]/g, '').toUpperCase();
			ajout.hidden = true;
			livreId = undefined;
			login.hidden = true;
			if (!/^(?:[0-9]{13}|[0-9]{9}[0-9X])$/.test(valeur)) {
				status.textContent = 'Saisissez un ISBN de 10 ou 13 caractères.';
				return;
			}
			enCours = true;
			bouton.disabled = true;
			isbn.disabled = true;
			status.textContent = 'Recherche en cours…';
			try {
				const response = await fetch(`${apiUrl}/isbn`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ isbn: valeur }),
					credentials: 'include', cache: 'no-store',
				});
				if (!response.ok) {
					login.hidden = response.status !== 401;
					throw new Error(await messageErreur(response));
				}
				const livre = await response.json();
				if (!livre || !Number.isSafeInteger(livre.id) || livre.id <= 0 || !(livre.title === null || typeof livre.title === 'string') ||
					!Array.isArray(livre.authors) || !livre.authors.every((nom: unknown) => typeof nom === 'string')) {
					throw new Error('Le résultat de la recherche est invalide.');
				}
				livreId = livre.id;
				champs.disabled = false;
				isbnAjout.textContent = valeur;
				titre.textContent = livre.title ?? '';
				auteur.textContent = livre.authors.join(', ');
				ajout.hidden = false;
				status.textContent = 'Ce livre est enregistré au catalogue. Vous pouvez l’ajouter à votre bibliothèque.';
				await chargerLivres();
			} catch (error) {
				status.textContent = error instanceof TypeError ? 'Impossible de contacter l’API.'
					: error instanceof Error ? error.message : 'La recherche a échoué.';
			} finally {
				enCours = false;
				bouton.disabled = false;
				isbn.disabled = false;
			}
		});

		ajout.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (enCours || !livreId) return;
			enCours = true;
			champs.disabled = true;
			bouton.disabled = true;
			isbn.disabled = true;
			login.hidden = true;
			status.textContent = 'Ajout en cours…';
			try {
				const response = await fetch(bibliothequeUrl, {
					method: 'POST', credentials: 'include',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ livre_id: livreId }),
				});
				if (!response.ok && response.status !== 409) {
					login.hidden = response.status !== 401;
					if (response.status === 404) throw new Error('Ce livre n’est plus disponible. Relancez la recherche.');
					throw new Error(await messageErreur(response));
				}
				livreId = undefined;
				status.textContent = response.status === 409
					? 'Ce livre est déjà dans votre bibliothèque.'
					: 'Livre ajouté à votre bibliothèque.';
			} catch (error) {
				status.textContent = error instanceof TypeError ? 'Impossible de confirmer l’ajout. Vérifiez votre bibliothèque avant de réessayer.'
					: error instanceof Error ? error.message : 'L’ajout a échoué.';
			} finally {
				enCours = false;
				champs.disabled = !livreId;
				bouton.disabled = false;
				isbn.disabled = false;
			}
		});
	}

	async function chargerLivres() {
		const status = document.querySelector<HTMLParagraphElement>('#livres-status');
		const login = document.querySelector<HTMLParagraphElement>('#livres-login');
		const liste = document.querySelector<HTMLUListElement>('#livres-liste');
		if (!status || !login || !liste) return;
		liste.replaceChildren();
		liste.hidden = true;
		login.hidden = true;
		status.textContent = 'Chargement des livres…';

		try {
			const response = await fetch(apiUrl, {
				credentials: 'include',
				cache: 'no-store',
			});
			if (response.status === 401) {
				status.textContent = 'Connectez-vous pour consulter les livres disponibles.';
				login.hidden = false;
				return;
			}
			if (!response.ok) throw new Error('Chargement impossible');

			const livres: unknown = await response.json();
			if (!Array.isArray(livres) || !livres.every((livre) =>
				livre && Number.isSafeInteger(livre.id) && livre.id > 0 &&
				typeof livre.titre === 'string' && typeof livre.auteur === 'string'
			)) throw new Error('Réponse invalide');

			if (livres.length === 0) {
				status.textContent = 'Aucun livre disponible pour le moment.';
				return;
			}

			liste.replaceChildren(...livres.map((livre) => {
				const ligne = document.createElement('li');
				const titre = document.createElement('span');
				titre.textContent = livre.titre;
				const auteur = document.createElement('span');
				auteur.textContent = livre.auteur;
				const bouton = document.createElement('button');
				bouton.type = 'button';
				bouton.textContent = 'Ajouter à ma bibliothèque';
				bouton.setAttribute('aria-label', `Ajouter ${livre.titre} à ma bibliothèque`);
				const message = document.createElement('span');
				message.setAttribute('role', 'status');
				bouton.addEventListener('click', async () => {
					if (bouton.disabled) return;
					bouton.disabled = true;
					bouton.textContent = 'Ajout en cours…';
					message.textContent = '';
					let ajoute = false;
					try {
						const response = await fetch(bibliothequeUrl, {
							method: 'POST',
							credentials: 'include',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ livre_id: livre.id }),
						});
						if (response.ok || response.status === 409) {
							ajoute = true;
							message.textContent = response.status === 409
								? 'Ce livre est déjà dans votre bibliothèque.'
								: 'Livre ajouté à votre bibliothèque.';
						} else if (response.status === 401) {
							login.hidden = false;
							message.textContent = 'Connectez-vous pour ajouter ce livre.';
						} else if (response.status === 404) {
							message.textContent = 'Ce livre n’est plus disponible. Actualisez le catalogue.';
						} else {
							message.textContent = await messageErreur(response);
						}
					} catch {
						message.textContent = 'Impossible de confirmer l’ajout. Vérifiez votre bibliothèque ou réessayez.';
					} finally {
						bouton.disabled = ajoute;
						bouton.textContent = ajoute ? 'Dans ma bibliothèque' : 'Ajouter à ma bibliothèque';
						bouton.setAttribute('aria-label', `${bouton.textContent} : ${livre.titre}`);
					}
				});
				ligne.append(titre, auteur, bouton, message);
				return ligne;
			}));
			liste.hidden = false;
			status.textContent = '';
		} catch {
			status.textContent = 'Impossible de charger les livres. Réessayez en actualisant la page.';
		}
	}

	initialiserRecherche();
	void chargerLivres();
</script>

<style>
	.livre-resultat dt {
		font-weight: 600;
		margin-top: 0.75rem;
	}

	.livre-resultat dd {
		margin: 0.25rem 0 0;
		overflow-wrap: anywhere;
	}

	.livres-page {
		max-width: 900px;
		margin: 0 auto;
		padding: 2rem;
	}

	section {
		margin-bottom: 2rem;
	}

	form, fieldset {
		max-width: 480px;
	}

	label, input, button {
		display: block;
		margin-top: 0.75rem;
	}

	input {
		box-sizing: border-box;
		width: 100%;
		padding: 0.6rem;
	}

	button {
		padding: 0.6rem 1rem;
		cursor: pointer;
	}

	button:disabled {
		cursor: wait;
	}

	#livres-liste :global(li + li) {
		border-top: 1px solid #ddd;
	}

	#livres-liste :global(li) {
		display: grid;
		grid-template-columns: minmax(0, 3fr) minmax(0, 2fr) 15rem;
		align-items: center;
		gap: 0.5rem 1.5rem;
		min-width: 620px;
		padding: 0.75rem 0;
	}

	#livres-liste :global(button) {
		width: 100%;
		margin: 0;
		padding: 0.4rem 0.75rem;
		cursor: pointer;
	}

	#livres-liste :global(button:disabled) {
		cursor: default;
	}

	#livres-liste :global([role="status"]:not(:empty)) {
		grid-column: 1 / -1;
	}

	#livres-liste :global([role="status"]:empty) {
		display: none;
	}

	#livres-liste {
		overflow-x: auto;
		list-style: none;
		padding: 0;
		line-height: 1.8;
		overflow-wrap: anywhere;
	}
</style>
