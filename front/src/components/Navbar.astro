
<nav class="navbar">
    <a href="/">Accueil</a>
    <a id="nav-library" href="/bibliotheque">Ma bibliothèque</a>
    <a href="/livres">Livres</a>
    <a id="nav-login" href="/login" hidden>Connexion</a>
    <a id="nav-session" href="/profil" hidden>Mon profil</a>
</nav>

<script>
    import { getSession, profileUrl } from '../lib/auth';
    async function afficherSession(refresh = false) {
        const link = document.querySelector<HTMLAnchorElement>('#nav-login');
        const status = document.querySelector<HTMLAnchorElement>('#nav-session');
        if (!link || !status) return;
        const user = await getSession(refresh);
        link.hidden = Boolean(user);
        status.hidden = !user;
        if (user) status.href = profileUrl(user.pseudo);
    }
    void afficherSession();
    window.addEventListener('pageshow', (event) => {
        if (event.persisted) void afficherSession(true);
    });
</script>

<style>
    .navbar {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 2rem;
        align-items: center;
        padding: 1rem 2rem;
        border-bottom: 1px solid #ddd;
    }

    .navbar a {
        color: inherit;
        text-decoration: none;
        font-weight: 500;
    }

    .navbar a:hover {
        text-decoration: underline;
    }
</style>
